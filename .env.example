# Centensor Environment Variables

# NextAuth / Auth.js Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="centensor-super-secret-production-key-change-me"
NEXTAUTH_URL="http://localhost:18667"

# Optional Social OAuth Providers (can be enabled by uncommenting in src/auth.ts)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
